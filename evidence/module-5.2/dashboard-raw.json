{
  "DashboardName": "epf-sentinel-dev",
  "DashboardArn": "arn:aws:cloudwatch::814454905497:dashboard/epf-sentinel-dev",
  "DashboardBody": {
    "widgets": [
      {
        "type": "metric",
        "x": 0,
        "y": 0,
        "width": 12,
        "height": 6,
        "properties": {
          "title": "Analyses started / completed",
          "region": "ap-south-1",
          "stat": "Sum",
          "period": 300,
          "metrics": [
            [
              "EPFSentinel",
              "AnalysisStarted"
            ],
            [
              ".",
              "AnalysisCompleted"
            ]
          ]
        }
      },
      {
        "type": "metric",
        "x": 12,
        "y": 0,
        "width": 12,
        "height": 6,
        "properties": {
          "title": "Terminal statuses (separate series \u2014 abstention \u2260 failure)",
          "region": "ap-south-1",
          "stat": "Sum",
          "period": 300,
          "metrics": [
            [
              "EPFSentinel",
              "AnalysisStatus",
              "Status",
              "COMPLETED"
            ],
            [
              "...",
              "COMPLETED_WITH_ABSTENTION"
            ],
            [
              "...",
              "FAILED_INFRASTRUCTURE"
            ],
            [
              "...",
              "FAILED_VALIDATION"
            ]
          ]
        }
      },
      {
        "type": "metric",
        "x": 0,
        "y": 6,
        "width": 12,
        "height": 6,
        "properties": {
          "title": "End-to-end analysis latency p50 / p95",
          "region": "ap-south-1",
          "metrics": [
            [
              "EPFSentinel",
              "AnalysisLatencyMs",
              {
                "stat": "p50",
                "period": 300
              }
            ],
            [
              "...",
              {
                "stat": "p95",
                "period": 300
              }
            ]
          ]
        }
      },
      {
        "type": "metric",
        "x": 12,
        "y": 6,
        "width": 12,
        "height": 6,
        "properties": {
          "title": "Gemini calls, latency, tokens",
          "region": "ap-south-1",
          "metrics": [
            [
              "EPFSentinel",
              "GeminiCalls",
              {
                "stat": "Sum",
                "period": 300
              }
            ],
            [
              ".",
              "GeminiLatencyMs",
              {
                "stat": "p95",
                "period": 300,
                "yAxis": "right"
              }
            ],
            [
              ".",
              "GeminiTokens",
              {
                "stat": "Sum",
                "period": 300
              }
            ]
          ]
        }
      },
      {
        "type": "metric",
        "x": 0,
        "y": 12,
        "width": 8,
        "height": 6,
        "properties": {
          "title": "Rule abstain reasons",
          "region": "ap-south-1",
          "stat": "Sum",
          "period": 300,
          "metrics": [
            [
              "EPFSentinel",
              "RuleAbstain",
              "Reason",
              "NO_APPLICABLE_RULE"
            ],
            [
              "...",
              "MODEL_OUTPUT_INVALID"
            ],
            [
              "...",
              "FABRICATED_CITATION"
            ],
            [
              "...",
              "UNGROUNDED_QUOTE"
            ],
            [
              "...",
              "TIMELINE_NOT_IN_SOURCE"
            ]
          ]
        }
      },
      {
        "type": "metric",
        "x": 8,
        "y": 12,
        "width": 8,
        "height": 6,
        "properties": {
          "title": "Evidence downgrades",
          "region": "ap-south-1",
          "stat": "Sum",
          "period": 300,
          "metrics": [
            [
              "EPFSentinel",
              "EvidenceDowngrade"
            ]
          ]
        }
      },
      {
        "type": "metric",
        "x": 16,
        "y": 12,
        "width": 8,
        "height": 6,
        "properties": {
          "title": "Document event DLQ depth",
          "region": "ap-south-1",
          "stat": "Maximum",
          "period": 60,
          "metrics": [
            [
              "AWS/SQS",
              "ApproximateNumberOfMessagesVisible",
              "QueueName",
              "epf-sentinel-doc-events-dlq-dev"
            ]
          ]
        }
      }
    ]
  }
}
